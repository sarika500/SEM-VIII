    Input(shape=(X_train.shape[1],)),
    Dense(1, activation='linear')
])

# Step 7: Compile model
model.compile(optimizer='adam', loss='mse', metrics=['mae'])

# Step 8: Train model
history = model.fit(
    X_train, y_train,
